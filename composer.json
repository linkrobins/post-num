{
    "name": "linkrobins/post-num",
    "description": "Adds a #N number to each post in a discussion. Ported to Flarum 2.0 from ziven/flarum-post-number.",
    "type": "flarum-extension",
    "license": "MIT",
    "authors": [
        {
            "name": "Karl Bullock",
            "email": "karl@linkrobins.com"
        }
    ],
    "require": {
        "php": "^8.3",
        "flarum/core": "^2.0"
    },
    "extra": {
        "flarum-extension": {
            "title": "Link Robins Post Numbers",
            "category": "feature",
            "icon": {
                "name": "fas fa-list-ol",
                "color": "#07adcc",
                "backgroundColor": "#1a2535"
            }
        },
        "flarum-cli": {
            "modules": {
                "githubActions": true
            }
        }
    }
}
